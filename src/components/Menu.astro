---
/* ═══════════════════════════════════════════════════════════════════════════
   MENU — full menu as structured content (never an image), by category, with
   dietary tags, prices, MAMMA/NONNA note, allergen disclaimer + PDF link.
   ═══════════════════════════════════════════════════════════════════════════ */
import { site } from "../data/site";
import {
  menu,
  allergenNote,
  dietaryLegend,
  NONNA_UPCHARGE,
} from "../data/menu";

/** Format a price as $X or $X.YZ. */
const fmt = (n: number) =>
  Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`;
---

<section id="menu" class="section laminex-band">
  <div class="container-deli">
    <div class="reveal text-center">
      <p class="kicker text-cream">The good stuff</p>
      <h2 class="mt-2 text-4xl text-cream sm:text-5xl">The Menu</h2>
      <p class="mx-auto mt-3 max-w-xl font-body text-cream/90">
        Made-to-order, one at a time. Two sizes on every sangaweech:
        <strong>Mamma</strong> (as priced) or <strong>Nonna</strong>
        (+{fmt(NONNA_UPCHARGE)}, for a bigger appetite).
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        menu.map((cat) => (
          <div
            id={`menu-${cat.id}`}
            class="reveal rounded-deli border-[3px] border-espresso bg-cream p-5 shadow-[var(--shadow-deli)] sm:p-6"
          >
            <div class="mb-4 border-b-[3px] border-dashed border-espresso/25 pb-3">
              <h3 class="text-2xl text-tomato sm:text-3xl">{cat.title}</h3>
              {cat.note && (
                <p class="mt-1 font-body text-sm text-espresso-700">
                  {cat.note}
                </p>
              )}
            </div>

            <ul class="space-y-4">
              {cat.items.map((item) => (
                <li>
                  <div class="flex items-baseline justify-between gap-3">
                    <h4 class="font-body text-base font-bold uppercase tracking-wide text-espresso">
                      {item.name}
                      {item.tags?.map((t) => (
                        <span
                          class="ml-1.5 inline-block rounded border border-olive px-1 text-xs font-bold text-olive"
                          title={
                            t === "V" ? "Vegetarian" : "Contains nuts"
                          }
                        >
                          {t}
                        </span>
                      ))}
                    </h4>
                    {item.price != null && (
                      <span class="shrink-0 font-display text-lg text-tomato">
                        {fmt(item.price)}
                      </span>
                    )}
                  </div>
                  {item.description && (
                    <p class="mt-0.5 font-body text-sm leading-snug text-espresso-700">
                      {item.description}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Legend + allergen note + PDF -->
    <div
      class="reveal mt-8 rounded-deli border-2 border-cream/40 bg-espresso/90 p-5 text-cream"
    >
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span class="font-body text-sm font-bold uppercase tracking-wide"
          >Legend:</span
        >
        {
          dietaryLegend.map((d) => (
            <span class="font-body text-sm">
              <span class="mr-1 rounded border border-mustard px-1 font-bold text-mustard">
                {d.code}
              </span>
              {d.label}
            </span>
          ))
        }
      </div>
      <p class="mt-3 font-body text-xs leading-relaxed text-cream/80">
        {allergenNote}
      </p>
      <div class="mt-4">
        <!-- TODO: place the real menu PDF at site.menuPdf (see data/site.ts). -->
        <a
          href={site.menuPdf}
          class="btn btn-secondary text-sm"
          target="_blank"
          rel="noopener"
        >
          Download the menu (PDF)
        </a>
      </div>
    </div>
  </div>
</section>
