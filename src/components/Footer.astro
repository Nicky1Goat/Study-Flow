---
/* ═══════════════════════════════════════════════════════════════════════════
   FOOTER — address, hours summary, socials, copyright, credit line slot.
   ═══════════════════════════════════════════════════════════════════════════ */
import { site } from "../data/site";

const year = new Date().getFullYear();

const socialLinks = [
  { label: "Instagram", href: site.socials.instagram },
  { label: "TikTok", href: site.socials.tiktok },
  { label: "Facebook", href: site.socials.facebook },
];
---

<footer class="border-t-[3px] border-espresso bg-espresso text-cream">
  <div class="container-deli grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Brand -->
    <div class="sm:col-span-2 lg:col-span-1">
      <span class="font-display text-3xl uppercase text-mustard">
        Sanga<span class="text-laminex">weech</span>
      </span>
      <p class="mt-3 font-script text-xl text-cream/90">
        Making Lygon Italian again.
      </p>
    </div>

    <!-- Visit -->
    <div>
      <h3 class="text-lg text-mustard">Visit</h3>
      <address class="mt-2 font-body not-italic text-cream/85">
        {site.address.street}<br />
        {site.address.suburb} {site.address.state} {site.address.postcode}
      </address>
    </div>

    <!-- Hours -->
    <div>
      <h3 class="text-lg text-mustard">Hours</h3>
      <ul class="mt-2 space-y-1 font-body text-sm text-cream/85">
        {
          site.hours.map((h) => (
            <li class="flex justify-between gap-3">
              <span>{h.day.slice(0, 3)}</span>
              <span>
                {h.open === "Closed" ? "Closed" : `${h.open}–${h.close}`}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-1 text-[10px] uppercase tracking-wide text-cream/50">
        Placeholder — confirm hours
      </p>
    </div>

    <!-- Social -->
    <div>
      <h3 class="text-lg text-mustard">Follow</h3>
      <ul class="mt-2 space-y-1 font-body text-cream/85">
        {
          socialLinks.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="text-cream/85 no-underline hover:text-mustard"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-cream/15">
    <div
      class="container-deli flex flex-col items-center justify-between gap-2 py-5 text-center font-body text-xs text-cream/60 sm:flex-row sm:text-left"
    >
      <p>© {year} {site.name}. All rights reserved.</p>
      <!-- Credit line slot — edit or remove as you like. -->
      <p>Panini made with love on Lygon Street.</p>
    </div>
  </div>
</footer>
