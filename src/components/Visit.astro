---
/* ═══════════════════════════════════════════════════════════════════════════
   VISIT US — address, embedded Google Map, hours, "no bookings" note,
   communal/kerbside seating note, and mobile click-to-call / directions.
   ═══════════════════════════════════════════════════════════════════════════ */
import { site } from "../data/site";

// Google Maps embed + directions from the address query (works without an API
// key). TODO: swap for the verified Google Business place once confirmed.
const mapQuery = encodeURIComponent(site.mapEmbedQuery);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`;
const phone: string = site.phone;
const telHref = phone ? `tel:${phone.replace(/\s+/g, "")}` : null;
---

<section id="visit" class="section">
  <div class="container-deli">
    <div class="reveal max-w-2xl">
      <p class="kicker">Come say ciao</p>
      <h2 class="mt-2 text-4xl text-espresso sm:text-5xl">Visit us</h2>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <!-- Details -->
      <div class="reveal space-y-6">
        <!-- Address -->
        <div>
          <h3 class="text-xl text-tomato">Where</h3>
          <!-- TODO: confirm exact street number (300 vs 380 Lygon St). -->
          <p class="mt-1 font-body text-lg text-espresso">
            {site.address.street}<br />
            {site.address.suburb} {site.address.state} {site.address.postcode}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a
              href={directionsUrl}
              target="_blank"
              rel="noopener"
              class="btn btn-secondary text-sm"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              >
              Get directions
            </a>
            {
              telHref && (
                <a href={telHref} class="btn btn-ghost text-sm">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.98.36 1.93.7 2.84a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.24-1.24a2 2 0 0 1 2.11-.45c.9.34 1.86.57 2.84.7A2 2 0 0 1 22 16.92Z" />
                  </svg>
                  Call us
                </a>
              )
            }
          </div>
        </div>

        <!-- Hours -->
        <div>
          <h3 class="text-xl text-tomato">Hours</h3>
          <!-- TODO: PLACEHOLDER HOURS — confirm real trading hours. -->
          <dl class="mt-2 divide-y divide-espresso/10">
            {
              site.hours.map((h) => (
                <div class="flex justify-between py-1.5 font-body">
                  <dt class="text-espresso">{h.day}</dt>
                  <dd class="font-semibold text-espresso-700">
                    {h.open === "Closed" ? "Closed" : `${h.open} – ${h.close}`}
                  </dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-2 text-xs uppercase tracking-wide text-tomato">
            ⚠ Placeholder hours — confirm before publishing.
          </p>
        </div>

        <!-- No bookings / seating note -->
        <div
          class="rounded-deli border-2 border-espresso/15 bg-cream-200 p-4 font-body text-espresso-700"
        >
          <p>
            <strong>No bookings, no fuss.</strong> Walk in, join the queue — the
            action stations keep it moving. Grab a spot at our communal or
            kerbside seating and chat to whoever's next to you. That's the whole
            idea.
          </p>
        </div>
      </div>

      <!-- Map -->
      <div class="reveal">
        <div
          class="h-full min-h-[320px] overflow-hidden rounded-deli border-[3px] border-espresso shadow-[var(--shadow-deli)]"
        >
          <iframe
            title={`Map to ${site.name}, ${site.address.full}`}
            src={mapEmbed}
            width="100%"
            height="100%"
            style="border:0; min-height:320px;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
