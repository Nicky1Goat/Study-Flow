---
/* ═══════════════════════════════════════════════════════════════════════════
   IMAGE SLOT — a clearly-labelled placeholder where a real brand photo goes.
   Renders the real <img> if `src` is provided; otherwise shows a dashed slot
   describing exactly what to drop in. Swap by setting `src` to a file in
   /public/images/ (see README → "Where to swap images").
   ═══════════════════════════════════════════════════════════════════════════ */
interface Props {
  /** Label describing the intended photo (shown in placeholder state). */
  label: string;
  /** Real image path once available, e.g. "/images/hero-shopfront.jpg". */
  src?: string;
  /** Alt text — always write meaningful alt for the real photo (a11y). */
  alt: string;
  /** aspect ratio, e.g. "4/3", "1/1", "16/9". */
  ratio?: string;
  class?: string;
  /** Eager-load above-the-fold images (hero); lazy-load the rest. */
  loading?: "eager" | "lazy";
}

const {
  label,
  src,
  alt,
  ratio = "4/3",
  class: className = "",
  loading = "lazy",
} = Astro.props;
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      loading={loading}
      decoding="async"
      style={`aspect-ratio:${ratio}`}
      class={`h-full w-full object-cover ${className}`}
    />
  ) : (
    <div
      style={`aspect-ratio:${ratio}`}
      class={`flex flex-col items-center justify-center gap-2 border-[3px] border-dashed border-espresso/40 bg-cream-200 p-4 text-center ${className}`}
      role="img"
      aria-label={`Image placeholder: ${alt}`}
    >
      <svg
        width="34"
        height="34"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        class="text-espresso/50"
        aria-hidden="true"
      >
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="8.5" cy="8.5" r="1.5" />
        <path d="m21 15-5-5L5 21" />
      </svg>
      <span class="font-script text-xl leading-tight text-espresso/70">
        {label}
      </span>
      <span class="text-xs uppercase tracking-wide text-espresso/40">
        Drop photo here
      </span>
    </div>
  )
}
