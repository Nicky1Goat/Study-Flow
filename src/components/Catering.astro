---
/* ═══════════════════════════════════════════════════════════════════════════
   CATERING & FUNCTIONS — the highest-value conversion path. Enquiry form wired
   to a form handler via env vars:
     • Netlify Forms  → PUBLIC_FORM_PROVIDER="netlify" (auto-detected at deploy;
       set the notification email in the Netlify dashboard).
     • Formspree      → PUBLIC_FORM_PROVIDER="formspree" + PUBLIC_FORMSPREE_ID.
   TODO: confirm the destination inbox (see CATERING_EMAIL in .env).
   ═══════════════════════════════════════════════════════════════════════════ */
const provider = import.meta.env.PUBLIC_FORM_PROVIDER || "netlify";
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID || "";

const isFormspree = provider === "formspree" && formspreeId;
const action = isFormspree ? `https://formspree.io/f/${formspreeId}` : undefined;
---

<section id="catering" class="section bg-olive text-cream">
  <div class="container-deli grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
    <!-- Pitch -->
    <div class="reveal">
      <p class="kicker text-mustard">Feed the whole famiglia</p>
      <h2 class="mt-2 text-4xl text-cream sm:text-5xl">Catering &amp; functions</h2>
      <p class="mt-5 font-body text-lg leading-relaxed text-cream/90">
        Office lunch, birthday, footy day or a full-blown famiglia function —
        we'll bring the sangaweech. Platters of made-to-order panini, chips and
        sweets, done properly.
      </p>
      <ul class="mt-6 space-y-2 font-body text-cream/90">
        <li class="flex items-start gap-2">
          <span class="text-mustard">◆</span> Platters &amp; grazing for groups of any size
        </li>
        <li class="flex items-start gap-2">
          <span class="text-mustard">◆</span> Vegetarian &amp; crowd-pleaser options
        </li>
        <li class="flex items-start gap-2">
          <span class="text-mustard">◆</span> Corporate, private &amp; event catering
        </li>
      </ul>
    </div>

    <!-- Form -->
    <div class="reveal">
      <form
        name="catering"
        method="POST"
        action={action}
        data-netlify={!isFormspree ? "true" : undefined}
        netlify-honeypot={!isFormspree ? "bot-field" : undefined}
        class="rounded-deli border-[3px] border-cream/60 bg-cream p-5 text-espresso shadow-[var(--shadow-deli)] sm:p-6"
      >
        <!-- Netlify needs the form name as a hidden input for static forms. -->
        {!isFormspree && <input type="hidden" name="form-name" value="catering" />}
        <!-- Honeypot (hidden from humans, catches bots). -->
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class="form-label" for="cat-name">Name</label>
            <input class="form-input" id="cat-name" name="name" type="text" required autocomplete="name" />
          </div>
          <div>
            <label class="form-label" for="cat-email">Email</label>
            <input class="form-input" id="cat-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div>
            <label class="form-label" for="cat-phone">Phone</label>
            <input class="form-input" id="cat-phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div>
            <label class="form-label" for="cat-date">Date</label>
            <input class="form-input" id="cat-date" name="date" type="date" />
          </div>
          <div>
            <label class="form-label" for="cat-headcount">Headcount</label>
            <input class="form-input" id="cat-headcount" name="headcount" type="number" min="1" inputmode="numeric" />
          </div>
          <div class="sm:col-span-2">
            <label class="form-label" for="cat-message">Message</label>
            <textarea class="form-input" id="cat-message" name="message" rows="4" placeholder="Tell us about your event…"></textarea>
          </div>
        </div>

        <button type="submit" class="btn btn-primary mt-5 w-full">
          Send catering enquiry
        </button>
        <p class="mt-3 text-center text-xs text-espresso-700">
          We'll get back to you within a couple of days.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  /* Scoped form styling — kept here so the design tokens stay consistent. */
  .form-label {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-espresso);
  }
  .form-input {
    width: 100%;
    padding: 0.65rem 0.8rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-espresso);
    background-color: var(--color-cream);
    border: 2px solid rgba(43, 29, 20, 0.35);
    border-radius: 0.5rem;
    transition: border-color 0.15s ease;
  }
  .form-input:focus {
    border-color: var(--color-tomato);
    outline: none;
  }
</style>
