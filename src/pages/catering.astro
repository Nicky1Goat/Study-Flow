---
/* ═══════════════════════════════════════════════════════════════════════════
   /catering — standalone catering & functions page for direct linking (e.g.
   from Instagram bio or Google). Reuses the Catering enquiry component.
   ═══════════════════════════════════════════════════════════════════════════ */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Catering from "../components/Catering.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
---

<BaseLayout
  title="Catering & Functions"
  path="/catering"
  description="Sangaweech catering & functions — panini platters, chips and sweets for office lunches, birthdays and events across Melbourne. Enquire now."
>
  <Header />
  <main id="main">
    <Catering />
  </main>
  <Footer />
  <StickyMobileCTA />
</BaseLayout>
