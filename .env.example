# ─────────────────────────────────────────────────────────────────────────────
# Sangaweech — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Variables prefixed with PUBLIC_ are exposed to the browser (client-side).
# ─────────────────────────────────────────────────────────────────────────────

# Canonical production URL — used for sitemap, canonical + Open Graph URLs.
SITE_URL="https://sangaweech.com.au"

# ── ORDERING / "SKIP THE QUEUE" ──────────────────────────────────────────────
# Drop in the real online-ordering link when you pick a provider
# (Square Online, me&u, Order-with-Google, Mr Yum, etc.).
# Until then the button falls back to a "coming soon" state.
PUBLIC_ORDER_URL=""

# ── CATERING ENQUIRY FORM ────────────────────────────────────────────────────
# Two supported handlers. The form auto-detects which to use:
#   1. Netlify Forms — set PUBLIC_FORM_PROVIDER="netlify" (no endpoint needed;
#      Netlify picks up the `data-netlify` attribute automatically).
#   2. Formspree — set PUBLIC_FORM_PROVIDER="formspree" and paste your form ID.
PUBLIC_FORM_PROVIDER="netlify"          # "netlify" | "formspree"
PUBLIC_FORMSPREE_ID=""                   # e.g. "xԱabcdyz" (only if using Formspree)

# Where catering enquiries should be emailed. If you use Netlify Forms, set the
# notification email in the Netlify dashboard instead — this is documentation.
# TODO: confirm destination inbox with the owner.
CATERING_EMAIL="catering@sangaweech.com.au"

# ── EMAIL / SMS SIGNUP ("STAY IN THE LOOP") ──────────────────────────────────
# Point this at your list provider's hosted form action URL
# (Mailchimp embedded-form action, Klaviyo list form, or ConvertKit form action).
PUBLIC_NEWSLETTER_ACTION=""
# Optional: some providers need a hidden field name — see README.
PUBLIC_NEWSLETTER_PROVIDER="mailchimp"   # "mailchimp" | "klaviyo" | "convertkit"

# ── ANALYTICS (optional) ─────────────────────────────────────────────────────
# Plausible / Fathom / GA4 — leave blank to disable. Wire up in BaseLayout.
PUBLIC_ANALYTICS_DOMAIN=""
